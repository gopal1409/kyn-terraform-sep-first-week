##inside the call module folder in main.tf delete everything copy line 2 till 26
module "networking" {
  source = "github.com/AimanNaseer123/Terraform-aws-module-sep-week1/modules/networking"
  #github.com/AimanNaseer123/Terraform-aws-module-sep-week1/modules/networking
  project_name = var.project_name
  environment = var.environment
  vpc_cidr_block = var.vpc_cidr_block
  subnets = var.subnets
  common_tags = local.common_tags
}

module "security_group" {
  source = "github.com/gopal1409/kyn-terraform-aws-module-sep-week1/modules/security-group"
  project_name = var.project_name   
    environment = var.environment
    vpc_id = module.networking.vpc_id
    app_port = 80
    ssh_cidr_blocks = ["0.0.0.0/0"]
    common_tags = local.common_tags
}


output "web_security_group_id" {
  description = "Web server security group ID"
  value       = aws_security_group.web.id
}


#after that as we added a new module
  terraform init
  terraform apply
