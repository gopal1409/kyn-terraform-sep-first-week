# Configure the AWS Provider
provider "aws" {
  region = var.aws_region #which will select the region where we are creating the resources
}

###########go to vpc.tf delete everything copy from line 61 till 74
  # Create a VPC
resource "aws_vpc" "projecty-vpc" { #the name of the refrence block is projecty-vpc custom naming convention
  cidr_block = var.vpc_cidr_block #this line should contains the vpc cidr block which is created earlier
  tags = local.common_tags
}

#with the refrence all the infomration whatever you created in aws will be stored inside the state file. The state file is a local file that is created in the same directory where you run the terraform commands. The state file is used to keep track of the resources that are created and their current state. It is important to keep the state file secure and backed up, as it contains sensitive information about your infrastructure.
#refrence block for the same resources cannot be duplicated in the same directory. If you want to create another VPC, you need to create a new resource block with a different name.
resource "aws_subnet" "projecty-subnet" {
  vpc_id     = aws_vpc.projecty-vpc.id #this subnet need to be mapped with your vpc
  #aws_vpc.projecty-vpc.id #this line should contains the vpc id which is created earlier
  #terraform apply : it will read all your manifest file and compare with your state file 
  cidr_block = var.subnet_cidr_block
  tags = local.common_tags
}

