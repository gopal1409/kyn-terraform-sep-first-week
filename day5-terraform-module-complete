4. Module: variables.tf
variable "project_name" {
  description = "Name of the project"
  type        = string
}

variable "environment" {
  description = "Environment of the project"
  type        = string
  default     = "dev"
}

variable "vpc_cidr_block" {
  description = "CIDR block for the VPC"
  type        = string
  default     = "10.0.0.0/16"
}

variable "subnets" {
  description = "Subnet configuration"

  type = map(object({
    cidr_block        = string
    availability_zone = string
  }))
}

variable "instances" {
  description = "EC2 instance configuration"

  type = map(object({
    subnet_key    = string
    instance_type = string
    instance_name = string
    key_name      = string
  }))
}

variable "ssh_cidr_blocks" {
  description = "CIDR blocks allowed to access EC2 through SSH"
  type        = list(string)
  default     = []
}

variable "app_port" {
  description = "Application port"
  type        = number
  default     = 80
}

Notice that I changed SSH from:

cidr_blocks = ["0.0.0.0/0"]

to a variable.

For example:

ssh_cidr_blocks = [
  "YOUR_PUBLIC_IP/32"
]

This is much safer.

