##lets create a new file lb-sg.tf if you see in this sg we are opening only port 80 and 443 copy line 2 till 39
resource "aws_security_group" "alb_sg" {
  name        = "gopal-projects-sg-lb"
  description = "sg TO ALLOW INBOUND TRAFFIC"
  vpc_id      = aws_vpc.projecty-vpc.id
  ingress {
    description = "Allow HTTP traffic"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp" 
    cidr_blocks = ["0.0.0.0/0"]
  }
    ingress {
    description = "Allow HTTPS traffic"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp" 
    cidr_blocks = ["0.0.0.0/0"]
  }

    
  egress {
    description = "Allow all outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1" 
    cidr_blocks = ["0.0.0.0/0"]
  }
  tags = local.common_tags
}

output "alb_sg_port" {  
    
  description = "The port of the alb security group"
  value       = {
    http = 80
    https = 443
  }
}
